{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "com.xsec.workspace.conversation-tree", "version": "1.0.0",
  "description": "XSEC conversation-tree workspace tool", "author": { "name": "XSEC" }, "license": "MIT",
  "extensions": { "com.xsec.desktop": {
    "schemaVersion": 1, "displayName": "对话树", "publisher": "XSEC", "icon": "message-circle",
    "engines": { "xsec": ">=0.1.0", "pluginApi": "^1.0.0" },
    "entrypoints": { "frontend": "./com.xsec.desktop/frontend/index.js" },
    "activationEvents": ["onWorkspaceTool:conversation-tree"], "permissions": { "workspace.session.read": {} },
    "contributes": { "workspaceTools": { "conversation-tree": {
      "title": "对话树", "icon": "message-circle", "scope": "session", "launchable": true,
      "policy": "singleton", "surface": "standard", "retain": "active", "preferredSideWidth": 420,
      "preferredBottomHeight": 340, "surfaces": ["interactive-dock"]
    } } }
  } }
}
