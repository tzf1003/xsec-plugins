{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "com.xsec.workspace.browser", "version": "1.0.0", "description": "XSEC browser workspace tool", "author": { "name": "XSEC" }, "license": "MIT",
  "extensions": { "com.xsec.desktop": {
    "schemaVersion": 1, "displayName": "浏览器会话", "publisher": "XSEC", "icon": "globe",
    "engines": { "xsec": ">=0.1.0", "pluginApi": "^1.0.0" }, "entrypoints": { "frontend": "./com.xsec.desktop/frontend/index.js" },
    "activationEvents": ["onWorkspaceTool:browser"], "permissions": { "workspace.session.read": {}, "browser.control": {} },
    "contributes": { "workspaceTools": { "browser": { "title": "浏览器会话", "icon": "globe", "scope": "session", "launchable": true, "policy": "singleton", "surface": "edge-to-edge", "retain": "always", "preferredSideWidth": 880, "preferredBottomHeight": 480, "surfaces": ["interactive-dock", "batch-observe"] } } }
  } }
}
