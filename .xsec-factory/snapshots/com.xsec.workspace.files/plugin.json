{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "com.xsec.workspace.files", "version": "1.3.1", "description": "XSEC project files workspace tool", "author": { "name": "XSEC" }, "license": "MIT",
  "extensions": { "com.xsec.desktop": {
    "schemaVersion": 1, "displayName": "项目文件", "publisher": "XSEC", "icon": "folder-open",
    "engines": { "xsec": ">=0.1.0", "pluginApi": "^1.4.0" }, "entrypoints": { "frontend": "./com.xsec.desktop/frontend/index.js" },
    "activationEvents": ["onWorkspaceTool:files"], "permissions": { "workspace.project.read": {}, "filesystem.workspace.read": {}, "workspace.composer.write": {} },
    "frontendApi": { "version": 2, "module": "single-esm", "methods": {
      "xsec.files.list": { "capability": "filesystem.workspace.read", "binding": "context" },
      "xsec.files.read": { "capability": "filesystem.workspace.read", "binding": "context" },
      "xsec.workspace.composer.path.add": { "capability": "workspace.composer.write", "binding": "context" },
      "xsec.workspace.composer.line-comment.add": { "capability": "workspace.composer.write", "binding": "context" }
    } },
    "contributes": { "workspaceTools": { "files": { "title": "项目文件", "icon": "folder-open", "scope": "project", "launchable": true, "policy": "singleton", "surface": "standard", "retain": "active", "preferredSideWidth": 460, "preferredBottomHeight": 360, "surfaces": ["interactive-dock"] } } }
  } }
}
